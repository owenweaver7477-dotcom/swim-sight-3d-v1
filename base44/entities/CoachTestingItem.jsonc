{
  "name": "CoachTestingItem",
  "type": "object",
  "properties": {
    "testing_session_id": {
      "type": "string",
      "description": "Reference to CoachTestingSession"
    },
    "club_id": {
      "type": "string",
      "description": "Reference to club"
    },
    "checklist_key": {
      "type": "string",
      "description": "Unique key for this checklist item"
    },
    "label": {
      "type": "string",
      "description": "Display label for this checklist item"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "tested",
        "issue_found",
        "skipped"
      ],
      "default": "not_started"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Severity if issue_found"
    },
    "notes": {
      "type": "string",
      "description": "Tester notes for this item"
    },
    "route": {
      "type": "string",
      "description": "App route this item relates to"
    }
  },
  "required": [
    "testing_session_id",
    "club_id",
    "checklist_key",
    "label"
  ]
}